# DepTime reads configuration from environment variables. Everything is optional.

# --- Local mode (deptime mcp / CLI) ---
# DEPTIME_HOME=~/.cache/deptime              # index + build cache (default: $XDG_CACHE_HOME/deptime or ~/.cache/deptime)
# DEPTIME_INDEX_PATH=~/.cache/deptime/index.sqlite
# DEPTIME_INDEX_URL=https://github.com/cschmertz/deptime/releases/download/index   # where `index pull` downloads from
# DEPTIME_INDEX_MAX_AGE_HOURS=24             # refresh check interval for a downloaded index
# DEPTIME_OFFLINE=false                      # true = never touch the network
# DEPTIME_COVERAGE_FILE=                     # custom coverage list (default: the one packaged with deptime)

# --- Building the index yourself (deptime ingest) ---
# DEPTIME_CACHE_DIR=~/.cache/deptime/build   # downloaded wheels, extracted sources, snapshot cache

# --- Optional hosted mode (deptime serve) ---
# DEPTIME_HOST=127.0.0.1
# DEPTIME_PORT=8000
# DEPTIME_PUBLIC_URL=http://127.0.0.1:8000
# DEPTIME_TRUST_PROXY_HEADERS=false          # true behind Fly/Cloud Run so client IPs come from X-Forwarded-For
# DEPTIME_TRUSTED_PROXY_HOPS=1               # proxies you run that append to X-Forwarded-For (client = Nth from the right)
# DEPTIME_CLIENT_IP_HEADER=                  # e.g. Fly-Client-IP; set only if your platform's proxy always sets it
# DEPTIME_ANON_DAILY_LIMIT=25                # anonymous calls per IP per day on a public instance
# DEPTIME_DEV_API_KEYS=                      # "key1:pro,key2:free" lets trusted callers bypass anonymous limits
