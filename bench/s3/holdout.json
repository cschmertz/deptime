   "requires": [
    "django>=4.0"
   ],
   "app": "from django.utils.encoding import force_text\n\n\ndef main():\n    return force_text(b\"abc\")\n",
   "expect": "cannot import name 'force_text'",
   "evidence": [
    "bench/cases/django.jsonl#django-force-text-oscar-phonenumber"
   ]
  },
