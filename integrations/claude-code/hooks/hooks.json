{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ". \"$CLAUDE_PLUGIN_ROOT/scripts/run_hint_hook.sh\"",
            "timeout": 10,
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ". \"$CLAUDE_PLUGIN_ROOT/scripts/run_hint_hook.sh\"",
            "timeout": 10,
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
